    {
      "id": "dependency_inversion",
      "kind": "principle",
      "summary": "Keep stable policy independent of changing implementation details through an owner-aligned contract.",
      "applicability": "Stable policy currently depends directly on volatile infrastructure or integration details.",
      "preconditions": "A stable responsibility-facing contract can be named.",
      "contraindications": "There is one stable implementation and no boundary or testing pressure.",
      "tradeoffs": "Adds interfaces, wiring, and indirection.",
      "question": "Which side owns the abstraction?",
      "authority": "general_advisory_knowledge",
      "match_reasons": [
        "concern:testability"
      ],
      "source_ref": "https://www.archunit.org/userguide/html/000_Index.html"
    },
    {
      "id": "strategy",
      "kind": "pattern",
      "summary": "Represent independently varying behavior behind one caller-owned contract.",
      "applicability": "At least two credible behaviors vary independently of the caller.",
      "preconditions": "Selection owner, lifetime, fallback, and stable inputs/outputs are known.",
      "contraindications": "There is only one fixed behavior or variants do not share a coherent contract.",
      "tradeoffs": "Improves variation isolation but adds selection and lifecycle complexity.",
      "question": "Who selects the behavior?",
      "authority": "general_advisory_knowledge",
      "match_reasons": [
        "concern:testability"
      ],
      "source_ref": "https://www.sei.cmu.edu/library/architecture-tradeoff-analysis-method-collection/"
    }
