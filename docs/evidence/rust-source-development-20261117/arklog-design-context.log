        "compatibility"
      ],
      "terms": [
        "cache",
        "latency",
        "repeated",
        "缓存",
        "延迟",
        "重复查询"
      ],
      "summary": "A caller or repository checks a cache before loading the source and explicitly owns population and invalidation.",
      "applicability": [
        "Repeated reads have measurable cost and bounded staleness is acceptable."
      ],
      "preconditions": [
        "Stable keys, invalidation policy, and source fallback are defined."
      ],
      "contraindications": [
        "Strong consistency is required without a coherent invalidation mechanism."
      ],
      "tradeoffs": [
        "Improves repeated-read latency but introduces stale data, miss concurrency, and memory pressure."
      ],
      "questions": [
        "What invalidates each key?",
        "How are concurrent misses handled?",
        "What is observable on fallback?"
      ],
