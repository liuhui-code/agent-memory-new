            "content": "export class TemperatureReducer {\n  reduce(readings: number[]): number {\n    let latest = 0;\n    for (const reading of readings) {\n      if (Number.isFinite(reading)) {\n        latest = reading;\n      } else {\n        latest = 0;\n      }\n    }\n    return latest;\n  }\n}",
