+def direct_body_text(body: str) -> str:
+    """Keep only the supplied callable's outer block, masking nested blocks."""
+    depth = 1
+    result = []
+    for char in body:
+        if char == "{":
+            depth += 1
+            result.append(" ")
+        elif char == "}":
+            depth -= 1
+            result.append(" ")
+            if depth == 0:
+                break
+        else:
+            result.append(char if depth == 1 else " ")
+    return "".join(result)
